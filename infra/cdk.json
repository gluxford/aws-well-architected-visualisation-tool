{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "config": {
      "projectName": "wa-visualizer",
      "primaryRegion": "us-east-1",
      "emailRestriction": {
        "enabled": false
      },
      "mfa": "optional",
      "customDomain": null
    }
  }
}
